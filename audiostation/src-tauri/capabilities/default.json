{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for audiostation",
  "platforms": [
    "macOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "shell:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "store:default",
    "store:allow-load",
    "store:allow-set",
    "store:allow-get",
    "store:allow-save",
    "process:allow-restart",
    "log:default",
    "log:allow-log"
  ]
}
