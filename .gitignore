output/
tmp/
.ai-productionization/

# Built web pages: `pip install` builds them (authorlm/setup.py), and
# contributors rebuild with `npm run build` in authorlm/web/<page>/
authorlm/authorlm/audiobook_dist/
authorlm/authorlm/triage_dist/
authorlm/authorlm/workbench_dist/
