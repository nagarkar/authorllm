{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command",
                  "command": "bash -lc 'authorlm client-hook' >/dev/null 2>&1",
                  "timeout": 5}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command",
                  "command": "bash -lc 'authorlm client-hook --end' >/dev/null 2>&1",
                  "timeout": 1}]}
    ]
  }
}
