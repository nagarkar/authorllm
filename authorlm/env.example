# Copy to .env and fill in. One variable per vendor you use.
GEMINI_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# The audiobook verbs (`authorlm audio voices|audition|dictionary push`,
# and the export's dictionary lookup). audiostation keeps its own copy.
# ELEVENLABS_API_KEY=

# Where this checkout's data lives (the database, backups, logs, Google
# token, all under <dir>/.authorlm/). Unset means your home directory.
# Set it to keep the data on another volume; `authorlm setup --workspace
# DIR` writes it for you. If the volume is not mounted, every command
# refuses rather than starting an empty database.
# AUTHORLM_WORKSPACE=
